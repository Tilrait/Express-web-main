<%- include('includes/header.ejs') %>
<h1>Подтверждение пароля для удаления аккаунта</h1>
<form method="post">
  <input
    id="deleteAcc"
    type="password"
    name="password"
    value="<% body.password %>"
  />
  <% if (errors.password) {%>
  <div>
    <span class="label error"> <%= errors.password.msg %> </span>
  </div>
  <% } %>
  <div class="horizontal">
    <input type="submit" value="Удалить" class="warning" />
  </div>
</form>
<%- include('includes/footer.ejs') %>